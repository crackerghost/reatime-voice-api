# ═══════════════════════════════════════════════════════════════════
# राहुल वॉयस असिस्टेंट — all controls (copy to .env and edit)
# Every var is optional; values below are the defaults.
# Shell env vars win over this file.
# ═══════════════════════════════════════════════════════════════════
GROQ_API_KEY=your_groq_key_here
# ---------- Voice / speaker ----------
# Reference audio clip for voice cloning (path relative to Voice_Cloning/)
VOICE_REF_AUDIO=my_voice.wav
# Exact transcript of that clip (used to build the voice-clone prompt)
VOICE_REF_TEXT=कोडिंग में बहुत मज़ा आता है, बट समटाइम्स बग्स आर सो अनोइंग यार।
# Where main.py saves its output
VOICE_OUTPUT=output.wav
# Demo text used by main.py when no CLI arg is given
VOICE_DEMO_TEXT=अरे वाह! आपने तो बहुत अच्छा सवाल पूछा।

# ---------- TTS model / quality ----------
# HF repo or local folder for the OmniVoice checkpoint
OMNIVOICE_MODEL=k2-fsa/OmniVoice
# Diffusion unmasking steps: 4 = fastest, 8 ≈ realtime (MPS), 16 = better quality
VOICE_NUM_STEP=16
# Max diffusion steps for the FIRST audio window (faster start;
# set = VOICE_NUM_STEP to disable)
VOICE_FIRST_STEP=6
# Allowed diffusion-step range (validated on every request)
VOICE_STEP_MIN=4
VOICE_STEP_MAX=64
# Sampling temperature for token selection (0 = greedy)
VOICE_TEMPERATURE=0.3
# Speaking speed used when a request doesn't send `speed`
VOICE_SPEED=1.0
# Sample rate for saved/streamed WAV (OmniVoice always generates 24 kHz)
VOICE_SAMPLE_RATE=24000
# Sentences synthesized together per audio window (1 = per sentence;
# 2-3 = fewer prosody restarts, more natural flow; smaller = faster frames)
VOICE_STREAM_WINDOW=2
# Max text chars per audio window / TTS frame (~90 ≈ 5s audio). Smaller =
# snappier first audio + shorter interrupt tail; bigger = smoother prosody.
# Never ship a non-final TTS window smaller than this (groups the LLM's short
# sentences into continuous frames instead of tiny 2-3 word audio chunks).
VOICE_MIN_WINDOW_CHARS=24
VOICE_WINDOW_CHARS=90
# Hard ceiling on sentences per chat reply (stops LLM rambling -> monologue)
VOICE_MAX_SENTENCES=8
# Greeting/small-talk replies stop after this many sentences
VOICE_GREETING_MAX=2
# Max utf-8 bytes per streaming sentence chunk (smaller =
VOICE_STREAM_MAX_CHARS=75
# Chars in the very first audio window (smaller = faster first audio)
VOICE_FIRST_WINDOW_CHARS=30   # 28-40 = fast first audio; smaller risks TTS fragmenting a clause
# Pauses after punctuation (seconds). Individually: VOICE_PAUSE_COMMA / _SEMI /
# _FULL / _QUESTION / _EXCLAM / _DANDA. Scale multiplies all.
VOICE_PAUSE_SCALE=1.0
# Per-sentence pacing (delivery energy). Excited >1.0 speeds up, dramatic <1.0
# slows down; long sentences (over VOICE_LONG_CHARS) get VOICE_LONG_SPEED.
VOICE_EXCITED_SPEED=1.12
VOICE_DRAMATIC_SPEED=0.92
VOICE_LONG_SPEED=0.96
VOICE_LONG_CHARS=110
VOICE_SPEED_MIN=0.3
VOICE_SPEED_MAX=2.0

# ---------- LLM (chat) ----------
# OpenAI-compatible model name (Groq hosts OpenAI's gpt-oss-120b as
# "openai/gpt-oss-120b"; any OpenAI-compatible model works if MISTRAL_URL is
# pointed at it).
LLM_MODEL=openai/gpt-oss-120b
# Sampling temperature for chat replies
LLM_TEMPERATURE=0.7
# Max tokens per chat reply. gpt-oss models "think" before answering and
# reasoning tokens count against this — keep it generous (2000) or hard
# questions can come back with EMPTY content (silent no-reply).
LLM_MAX_TOKENS=2000
# Reasoning effort for gpt-oss models on Groq: low | medium | high ("" = omit).
# "low" = fastest first audio; raise only if answers feel too shallow.
LLM_REASONING_EFFORT=low
# Groq API key (required; legacy fallbacks also read: LLM_API_KEY,
# MISTRAL_API_KEY). Get one at console.groq.com — it is NOT the Mistral key.
GROQ_API_KEY=
# Base URL for an OpenAI-compatible chat endpoint (defaults to Groq)
MISTRAL_URL=https://api.groq.com/openai/v1/chat/completions
# httpx stream timeout for the LLM call (seconds)
VOICE_LLM_TIMEOUT=120.0
# Optional: path to a text file that replaces the whole system prompt (tune the
# persona/voice style without editing code). Leave blank for the built-in one.
VOICE_PROMPT_FILE=

# ---------- Web chat UI behaviour (read from /api/config at page load) ----------
# nfe_step the browser sends for chat replies (quality vs speed)
VOICE_CHAT_STEP=12
# Conversation history kept per turn (older messages dropped)
VOICE_MAX_HISTORY=12
# WebSocket reconnect delay after a drop (ms)
VOICE_WS_RECONNECT_MS=1500
# SpeechRecognition restart delay when Chrome ends it (ms)
VOICE_REC_RESTART_MS=400
# Voice-activity check interval (ms) — drives barge-in + auto-send
VOICE_VAD_TICK_MS=50
# Silence after you stop talking before the message auto-sends (ms).
# Below ~500ms Whisper hears your speech in 1-2s fragments, each firing a
# separate reply. 700-900ms feels natural; 500ms is the aggressive floor.
VOICE_AUTO_SEND_MS=750
# Min non-space chars to treat recognized text as real words
VOICE_SEND_MIN_CHARS=2
# VAD energy gates:
VOICE_VAD_NOISE=0.005          # starting ambient noise floor
VOICE_VAD_THRESHOLD_MIN=0.014  # voice gate floor (RMS)
VOICE_VAD_GATE_MULT=3.4        # gate = noise * this (or the min above)
VOICE_VAD_SUSTAIN_MS=250       # sustained energy = real voice (arms barge/send)
VOICE_VAD_TEXT_MS=150          # …or words heard + this much energy confirm
VOICE_VAD_FAILSAFE_MS=900      # sustained-energy failsafe when recognition lags
VOICE_SPEAK_TAIL_MS=700        # ms after OUR speaker audio stops during which mic recognition is ignored (echo guard)
VOICE_VAD_REC_ACTIVE_MS=400    # recognizer "active" window during/after speech
VOICE_BARGE_IDLE_MS=900        # recognizer-idle safety-net auto-send delay

# ---------- Hardware ----------
# cpu | mps | cuda   (auto-detected if unset)
VOICE_API_DEVICE=
# fp16 | fp32  (fp16 = CUDA default; MPS/CPU default fp32 — fp16 MPS can crash on torch 2.14)
VOICE_API_DTYPE=

# ---------- Voice input: streaming ASR (/ws/asr) ----------
# The browser mic audio (already echo-cancelled by Chrome) is transcribed here,
# replacing the Web Speech API — how OpenAI/Gemini realtime avoid echo.
# Backend: auto | mlx | faster-whisper.
#   auto            — mlx-whisper on Apple Silicon (Neural Engine, ~10x faster
#                     than CPU) when installed; faster-whisper everywhere else
#                     (CUDA fp16 on Kaggle/NVIDIA, CPU int8 otherwise). This is
#                     the setting to keep for the Kaggle upload.
#   mlx             — Apple Silicon only (pip: mlx-whisper). Greedy decode.
#   faster-whisper  — CTranslate2: realtime on CUDA; CPU int8 elsewhere.
ASR_BACKEND=auto
# Model size: tiny | base | small | medium | large-v3-turbo.
#   large-v3-turbo (default) — the accuracy/speed sweet spot for Hindi/Hinglish
#     on both CUDA (Kaggle) and mlx (M4). ~1.6 GB. Best quality you can run
#     realtime in this pipeline; use it in production.
#   small — smaller download (~460 MB), noticeably worse Hindi; only if the
#     large download or RAM is a problem.
#   tiny / base — mangle Hindi; English experiments only.
ASR_MODEL=large-v3-turbo
# Spoken language: "hi" (default) = Hindi/Hinglish — accurate AND faster.
# LEAVE EMPTY only for true multilingual mode: Whisper auto-detect handles
# English well but routinely mislabels SHORT Hindi clips (as es/ru/ur…).
ASR_LANG=hi
# cpu | cuda (auto-detected if unset) — faster-whisper backend only
ASR_DEVICE=
# int8 (CPU) | float16 (CUDA) | float32 — auto-chosen if unset (fw backend)
ASR_COMPUTE=
# Whisper partial (live caption) cadence: new audio seconds + min gap seconds
VOICE_ASR_PARTIAL_NEW_SECONDS=0.45
VOICE_ASR_PARTIAL_GAP_SECONDS=0.9
# faster-whisper only: beam width for the AUTHORITATIVE final transcript (what
# gets sent to the assistant). 5 = better Hinglish accuracy for ~1.5x one-pass
# cost once per utterance. mlx-whisper has no beam decoder (always greedy).
ASR_FINAL_BEAM=5
# ---------- Noise-immune turn-taking (server-side neural VAD) ----------
# auto = Silero neural VAD when installed (recommended), else browser energy VAD
ASR_VAD_MODE=auto
# Silero thresholds: p(voice) to OPEN a turn (high = noise-proof) and to STAY
VOICE_SILERO_ON=0.55
VOICE_SILERO_HOLD=0.35
VOICE_SILERO_ON_MS=150        # speech this long opens the turn
VOICE_SILERO_SILENCE_MS=700   # silence this long closes it (end of speech)
VOICE_SERVER_PRE_ROLL_S=0.4   # server-side ring buffer kept before the open decision
VOICE_MIN_UTT_MS=300          # utterances shorter than this are discarded as blips

# Speculative turn trigger: the browser starts the LLM reply on a fast greedy
# transcript (1) — the accurate beam final then reconciles in the background.
# 0 disables (reply waits for the beam final; higher latency, simplest path).
VOICE_ASR_SPECULATIVE=1
# How long the client waits for the speculative/final transcript before
# releasing the mic anyway (ms).
VOICE_SPECULATIVE_MS=5000
# Anti-repetition-loop: max identical neighbouring words kept in a transcript
# ("अगर अगर अगर…" -> "अगर अगर"). 2 default; 1 = stricter; 0 = keep as-is.
VOICE_ASR_MAX_DUP=2
# faster-whisper only: block exact n-gram repeats during decoding (3 default;
# 0 = disable). mlx has none — relies on VOICE_ASR_MAX_DUP.
VOICE_ASR_NO_REPEAT_NGRAM=3

# ---------- Speaker-identity gate (competing-voice rejection) ----------
# Enrolls a voiceprint from VOICE_REF_AUDIO (the TTS clone clip) and drops any
# utterance that doesn't sound like the primary speaker (phone videos in the
# background, other people). Same speaker ~0.75-0.95, others ~0.4-0.6.
# Needs `uv pip install resemblyzer`; auto-disables if missing (fails open).
VOICE_SPEAKER_GATE=auto       # auto = on when resemblyzer + ref clip exist; 0 = off
VOICE_SPEAKER_SIM_MIN=0.62    # cosine threshold; raise (0.7) for stricter, lower (0.55) if your own mic is rejected

# ---------- Impulse-noise gate (finger snaps, claps, knocks) ----------
# Silero can hold an utterance open on a loud impulse, but snaps carry almost
# no real voiced audio. Require this much Silero-confirmed speech (ms) before
# transcribing. Real words are 200ms+; snaps land at 0-90ms. Server-VAD mode
# only (the legacy client-VAD path has no per-frame Silero to measure with).
VOICE_MIN_VOICED_MS=160

# ---------- Server ----------
VOICE_HOST=0.0.0.0
VOICE_PORT=8000

# ---------- Downloads ----------
# Force classic HTTP instead of hf_xet chunked CDN (needed on this network)
HF_HUB_DISABLE_XET=1